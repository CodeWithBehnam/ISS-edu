{
  "name": "iss-edu",
  "version": "0.1.0",
  "private": true,
  "description": "A live International Space Station tracker: a cute isometric 3D globe with real SGP4 orbits, Sun lighting, pass predictions and the crew aboard.",
  "keywords": [
    "iss",
    "international-space-station",
    "satellite-tracker",
    "sgp4",
    "three.js",
    "react-three-fiber",
    "react",
    "vite",
    "typescript",
    "education"
  ],
  "homepage": "https://codewithbehnam.github.io/ISS-edu/",
  "bugs": {
    "url": "https://github.com/CodeWithBehnam/ISS-edu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeWithBehnam/ISS-edu.git"
  },
  "license": "MIT",
  "author": {
    "name": "Behnam Ebrahimi",
    "url": "https://github.com/CodeWithBehnam"
  },
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:countries": "bun run scripts/build-countries.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.104.4",
    "@react-three/fiber": "^8.15.19",
    "@tanstack/react-query": "^5.40.0",
    "@tanstack/react-query-devtools": "^5.40.0",
    "clsx": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "satellite.js": "^5.0.0",
    "three": "^0.160.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "three-globe": "2.45.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.3.1"
  }
}
