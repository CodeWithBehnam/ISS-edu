{
  "name": "iss-edu",
  "version": "0.1.0",
  "private": true,
  "description": "A live International Space Station tracker: a cute isometric 3D globe with real SGP4 orbits, Sun lighting, pass predictions and the crew aboard.",
  "keywords": [
    "iss",
    "international-space-station",
    "satellite-tracker",
    "sgp4",
    "three.js",
    "react-three-fiber",
    "react",
    "vite",
    "typescript",
    "education"
  ],
  "homepage": "https://codewithbehnam.github.io/ISS-edu/",
  "bugs": {
    "url": "https://github.com/CodeWithBehnam/ISS-edu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeWithBehnam/ISS-edu.git"
  },
  "license": "MIT",
  "author": {
    "name": "Behnam Ebrahimi",
    "url": "https://github.com/CodeWithBehnam"
  },
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:countries": "bun run scripts/build-countries.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "clsx": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "satellite.js": "^5.0.0",
    "three": "^0.186.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "three-globe": "2.45.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.4"
  }
}
